# cms private live config
cms/config.php

# scratch / transient
/work/
*.pyc
__pycache__/
*.tmp

# local dev-only tooling for the smoke gates (jsdom / php-parser); never shipped
node_modules/

# batch workspace scratch (regenerable); MEDIA IS TRACKED — snapshots respect
# .gitignore, so untracked media does not survive sandbox restarts (lesson 5 Sep)
demo65/work/tags/
demo65/work/sheets/
demo65/work/run.log

# keep ground truth + provenance in git:
#   demo65/work/designs.json · demo65/suppliers/*.csv · demo65/config.json · demo65/status.py

# launch video intermediates
launch/plates/
launch/frames/

# relay v2 runtime state (written on its host, never source)
cms/relay/relay-last-tick.json

# ─── Play Store / Android launch kit ───
# The signing keystore is the ONE thing that can never be recreated: lose it and
# the app can never be updated again. It lives only on the owner's machine and
# in his offline backup — never in git.
*.keystore
*.jks
*.p12
*.pfx
keystore.properties
# the Bubblewrap-generated Android project (build output, downloads icons at build time)
playstore/twa/
playstore/graphics/out/screenshots/
