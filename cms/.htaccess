# ─── SHIVAA — Apache/LiteSpeed rules (Hostinger shared hosting) ───
Options -Indexes
RewriteEngine On

# v81 — block path-level exposure before anything else
RewriteRule (^|/)\.git(?:/|$) - [F,NC]
RewriteRule (^|/)node_modules/ - [F,NC]
RewriteRule ^relay/ - [F,NC,L]
RewriteRule (^|/)\.env - [F,NC]

# API: /api/...  →  api.php
RewriteRule ^api/(.*)$ api.php?__route=$1 [QSA,L]

# v107 — robots.txt has advertised /sitemap.xml forever; generate it from db.json
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# v107 — the data/ folder is server-state only (db.json, sms-config.json,
# error logs). *.json was already denied; this closes .txt/.log gaps too.
RewriteRule ^data/ - [F,NC,L]

# Existing files & folders served as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback → index.html
RewriteRule ^ index.html [L]

# ─── performance · v119 ───
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
# v119 — brotli when the host has it (LiteSpeed/Apache); deflate above stays
# as the fallback, so this is a pure win on modern phones.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml font/woff2
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType font/woff2 "access plus 365 days"
  ExpiresByType application/pdf "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
# v119 — every asset the page loads carries a ?v= release stamp, so a
# versioned URL can be cached for a year and never revalidated. Un-versioned
# URLs keep the rules above (html stays no-cache).
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|png|jpe?g|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{QUERY_STRING} =~ /(^|&)v=/"
  </FilesMatch>
  # v166 · WHY THE STAMP MUST MOVE. A ?v= URL is cached for a YEAR, so a stamp
  # that never changes pins that file on every device for a year: styles.css
  # sat at ?v=107 through dozens of releases and shoppers kept the old design
  # ("people who logged in 15 days ago still see the old version"). Every
  # release now re-stamps EVERY asset (index.html + sw.js SHELL_FILES), so a
  # returning device is always asking for URLs it has never cached.
  # The files that decide WHICH release is live can never be cached at all.
  <FilesMatch "^(sw\.js|index\.html|manifest\.webmanifest|manifest\.json|offline\.html)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
  </FilesMatch>
  # API answers (release check, rates, catalogue) are never stored by a cache
  <FilesMatch "^api\.php$">
    Header always set Cache-Control "no-store"
  </FilesMatch>
</IfModule>
AddType font/woff2 .woff2
AddType application/pdf .pdf

# ─── hardening ───
<FilesMatch "\.(json|lock|md|sh|py)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(server\.js|api\.php\.bak|package\.json|composer\.(json|lock)|db\.json.*|router-dev\.php|samples-payload\.json)$">
  Require all denied
</FilesMatch>
# v81 — include-only PHP libraries have no direct URL entry point
<FilesMatch "^(sms|mail|trust|hallmark)\.php$">
  Require all denied
</FilesMatch>
# v81/v83 — one-shot maintenance/repair tool (password-gated AND
# brute-force-throttled since v83); still blocked at the edge. If ever
# genuinely needed, temporarily rename it to a secret name in File
# Manager, run it, delete it.
<FilesMatch "^migrate-repair\.php$">
  Require all denied
</FilesMatch>
# backups / editor leftovers must never be served
<FilesMatch "\.(bak|old|orig|save|swp|tmp|log|ini|sql|zip|tar|gz)$">
  Require all denied
</FilesMatch>

# ─── security headers ───
<IfModule mod_headers.c>
  Header always unset X-Powered-By
  Header always unset Server
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set X-Permitted-Cross-Domain-Policy "none"
  Header always set X-DNS-Prefetch-Control "off"
  # HSTS — only meaningful over HTTPS; Hostinger serves SSL
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  # CSP — self-hosted assets; v94 only the PayU hosted page is a form target
  # (signed full-page POST redirect). PhonePe/Razorpay hosts removed with the
  # gateway options; Render relay stays for the free bullion feed.
  # v130 — Cashfree v3 JS SDK (hosted checkout, redirectTarget _self) loads
  # from sdk.cashfree.com: without it in script-src the browser BLOCKS the
  # SDK for every visitor → the v128 "infinite spinner" symptom. Also allow
  # its API/img hosts for pre-checkout calls and pixels.
  # v132 — THE actual "infinite spinner" bug: the v3 SDK opens the hosted
  # checkout in its OWN full-screen iframe and resolves optimistically. With
  # no frame-src, the browser fell back to default-src 'self' and silently
  # killed that iframe → SDK said "launched", nothing appeared, no error.
  # frame-src (and form-action, for SDKs that submit instead) must allow it.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://*.cashfree.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://*.cashfree.com; font-src 'self' data:; connect-src 'self' https://*.cashfree.com; frame-src 'self' https://*.cashfree.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://*.cashfree.com; object-src 'none'; worker-src 'self'"
</IfModule>
