{
  "id": "/desk.html",
  "name": "Shivaa Bullion Desk",
  "short_name": "Shivaa Desk",
  "description": "The jeweller desk as an app: live gold and silver rates per fine gram, 90-second firm quotes, dealing slips and a day book. Partners only.",
  "start_url": "/desk.html#/partner?view=bullion",
  "scope": "/desk.html",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0b0a08",
  "theme_color": "#0b0a08",
  "lang": "en-IN",
  "dir": "ltr",
  "categories": ["business", "finance", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/images/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/images/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/images/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Live rates", "short_name": "Rates", "url": "/desk.html#/partner?view=bullion", "description": "The live board" },
    { "name": "Calculator & quote", "short_name": "Quote", "url": "/desk.html#/partner?view=bullion&sec=calc", "description": "Price grams and take a firm quote" },
    { "name": "Day book", "short_name": "Day book", "url": "/desk.html#/partner?view=bullion&sec=book", "description": "Today's trades, slips and open metal" },
    { "name": "My deals", "short_name": "Deals", "url": "/desk.html#/partner?view=bullion&sec=deals", "description": "Orders and what is still open" }
  ]
}
